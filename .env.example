# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
HOST=0.0.0.0
PORT=5000

# AI Image Analysis API Configuration
# Set one of these providers or use manual search fallback
# Options: "openai", "google", "custom", or leave empty for manual-only mode
AI_PROVIDER=

# OpenAI Vision API (GPT-4V)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-vision-preview

# Google Gemini Vision API
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-pro-vision

# Custom API endpoint
CUSTOM_API_URL=
CUSTOM_API_KEY=

# Rate Limiting
RATE_LIMIT_DEFAULT=200 per day;50 per hour
RATE_LIMIT_UPLOAD=10 per minute;30 per hour

# Upload Configuration
MAX_CONTENT_LENGTH=10485760  # 10MB max upload
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp

# Privacy Settings
STORE_UPLOADS=False
UPLOAD_RETENTION_HOURS=1

# Logging
LOG_LEVEL=INFO